APP_NAME="Panel de Hostelería"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel_hosteleria
DB_USERNAME=panel_hosteleria
DB_PASSWORD=CAMBIAR_CONTRASENA_BD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_es_0900_ai_ci
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
PLANIFICACION_TURNOS_EXPORT_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_USUARIO_SMTP
MAIL_PASSWORD=CAMBIAR_CONTRASENA_SMTP
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

DEMO_MODE=false
DEMO_DATABASE=
SUPERADMIN_NAME="Administración"
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CAMBIAR_CONTRASENA_LARGA_Y_UNICA

VITE_APP_NAME="${APP_NAME}"
